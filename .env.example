# FlashGuard Environment Variables
# Copy this to .env and fill in your values

# ── LLM Provider (Groq — free tier, fast) ─────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Which Groq model to use for Node 4 LLM Escalation
# Options: llama-3.1-8b-instant (fast), llama-3.3-70b-versatile (smarter)
LLM_MODEL=llama-3.1-8b-instant

# ── Redis (managed by docker-compose, change only if external) ─────────────────
REDIS_URL=redis://redis:6379/0

# ── Services (all managed by docker-compose) ───────────────────────────────────
AGENT6_URL=http://agent6:8000
BDH_URL=http://bdh_watchdog:8090
GATEWAY_URL=http://gateway:8080
